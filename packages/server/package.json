{
  "name": "@llm-wiki/server",
  "version": "0.1.0",
  "description": "Hono API server for LLM Wiki",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/node-server": "^1.12.0",
    "@llm-wiki/core": "workspace:*",
    "hono": "^4.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.0.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "@llm-wiki/core": "workspace:*"
  }
}
