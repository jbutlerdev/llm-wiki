{
  "name": "@llm-wiki/mcp",
  "version": "0.1.0",
  "description": "MCP server for LLM Wiki - exposes wiki operations as MCP tools",
  "keywords": ["wiki", "mcp", "model-context-protocol", "claude"],
  "author": "jbutlerdev <jbutlerdev@example.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "llm-wiki-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest --run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@llm-wiki/core": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@llm-wiki/core": "^0.1.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "@llm-wiki/core": "^0.1.0"
  }
}
