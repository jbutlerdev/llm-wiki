{
  "name": "@llm-wiki/cli",
  "version": "0.1.0",
  "description": "CLI for LLM Wiki",
  "type": "module",
  "bin": {
    "llm-wiki": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest --run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@llm-wiki/core": "0.1.0",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "@llm-wiki/core": "workspace:*"
  }
}
