{
  "name": "@llm-wiki/core",
  "version": "0.1.0",
  "description": "Core wiki operations and types",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest --run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tobilu/qmd": "^2.1.0",
    "chokidar": "^4.0.0",
    "execa": "^9.0.0",
    "gray-matter": "^4.0.3",
    "marked": "^14.0.0",
    "turndown": "^7.2.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/turndown": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
